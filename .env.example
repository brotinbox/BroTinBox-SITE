# Copy to .env.local for development and add the same keys in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# Google One Tap & OAuth (Google Cloud Console → APIs & Services → Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public site URL (used for metadata, sitemap and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret staff console path: the console lives at /<ADMIN_PATH>, /admin is a 404.
# 6–64 characters of a-z, 0-9 or "-". Keep it private.
ADMIN_PATH=

# Rate limiting (Upstash Redis REST). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enquiry notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cashfree Payment Gateway (Merchant Dashboard → Developers → API Keys).
# Test keys with sandbox; Live keys with production. Server only, never expose.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production. Public because the browser SDK needs the same mode.
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Automated Blog Engine (DeepSeek 4.1 Flash for content, OpenAI Sunburst for images)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Cloudflare R2 Storage (Zero-egress CDN for blog images)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Search Console OAuth client (scripts/gsc.ts)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
