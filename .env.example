# Copy to .env.local for development and add the same keys in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# Google One Tap & OAuth (Google Cloud Console → APIs & Services → Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WhatsApp OTP login (Meta Cloud API: developers.facebook.com → your app → WhatsApp → API Setup).
# Server only. Use a permanent System User token in production, not the 24h test token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
OTP_HASH_SECRET=                     # any long random string
# Phone sign-in mode (off / test / live), test numbers, template and language are set in
# admin → Settings → Phone sign-in. These four are only fallbacks until that is saved.
PHONE_OTP_MODE=off
PHONE_OTP_TEST_NUMBERS=
WHATSAPP_OTP_TEMPLATE=login_otp
WHATSAPP_OTP_LANG=en
# Webhook: https://www.brotinbox.com/api/whatsapp/webhook (delivery failures → Vercel logs)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=       # any random string; paste the same in Meta → WhatsApp → Configuration
WHATSAPP_APP_SECRET=                 # Meta app → Settings → Basic → App secret (verifies webhook signatures)
# Trial WhatsApp follow-ups: mode, test numbers, Business Account ID and wording are set in
# admin → Settings → WhatsApp follow-ups. These two are only fallbacks until that is saved.
WHATSAPP_WABA_ID=
TRIAL_FOLLOWUP_MODE=off

# Public site URL (used for metadata, sitemap and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret staff console path: the console lives at /<ADMIN_PATH>, /admin is a 404.
# 6–64 characters of a-z, 0-9 or "-". Keep it private.
ADMIN_PATH=

# Rate limiting (Upstash Redis REST). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Staff alerts on Telegram (optional). The chat ID can be set in admin → Settings → Staff alerts;
# TELEGRAM_CHAT_ID is only the fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cashfree Payment Gateway (Merchant Dashboard → Developers → API Keys).
# Test keys with sandbox; Live keys with production. Server only, never expose.
# Live keys (Cashfree dashboard in Production mode). Test/Live is switched in admin → Settings.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Test keys (Cashfree dashboard in Test mode). Optional; app ids starting TEST in the vars above also work as test keys.
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=
# Only if the Cashfree webhook setup generated its own secret (otherwise the secret key above signs webhooks).
CASHFREE_WEBHOOK_SECRET=
# Optional fallback only: used until Test/Live is saved once in admin → Settings.
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Automated Blog Engine (DeepSeek 4.1 Flash for content, OpenAI Sunburst for images)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Cloudflare R2 Storage (Zero-egress CDN for blog images)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Search Console OAuth client (scripts/gsc.ts)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# Scheduled jobs: pg_cron calls /api/cron/* with this bearer secret (store the same value in Supabase Vault as brotin_cron_secret)
CRON_SECRET=
